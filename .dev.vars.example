# Deploy-button secret prompts. Never put real credentials in this file.
# Generate two independent secrets in a password manager, or run
# `openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'` twice locally.
# Use the first output for SETUP_TOKEN and prefix the second with dl_ for WEBSITE_API_KEY.
SETUP_TOKEN=
WEBSITE_API_KEY=
# Resend sending API key for your verified sender. Native Cloudflare email
# is an alternative configured after deployment; see deploy/cloudflare/TRIAL.md.
RESEND_API_KEY=
