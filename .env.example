# Copy to .env. docs/SELF-HOSTING.md explains every line.
#
# Passwords go inside connection URLs, so use letters and digits only:
#   openssl rand -hex 24

# ── Docker Compose ─────────────────────────────────────────────────────────

# The tables' owner, which runs migrations and backups.
POSTGRES_PASSWORD=changeme
# deuceleague_app, which the API connects as so row-level security applies
# (see docs/DATA-MODEL.md § Tenancy enforcement). Each start sets it.
APP_DB_PASSWORD=changeme

# The website's key: members:read, members:write and members:pii. Make it
# after club:create — docs/SELF-HOSTING.md § The website shows how.
WEBSITE_API_KEY=
# The address players use. Links in sign-in emails point here.
PUBLIC_URL=http://localhost:8080
# How sign-in emails go out. Unset, the website writes each link to its log.
SMTP_URL=
MAIL_FROM=
# Where the courts are, for the weather outlook on the home page (from
# Open-Meteo, free for non-commercial use). Leave both empty for no outlook.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
# uk: °C and mph · metric: °C and km/h · us: °F and mph
WEATHER_UNITS=uk

# On the server only (docs/SELF-HOSTING.md): Caddy for HTTPS, nightly backups,
# and no port open but 80 and 443.
# COMPOSE_FILE=docker-compose.yml:deploy/compose.production.yml
# DOMAIN=league.example.org
# BACKUP_KEEP_DAYS=14

# On the demo instance only: keeps its published read-only keys the same.
# DEMO_KEY_SEED=

# ── Running from source with npm ───────────────────────────────────────────
# With `docker compose up -d postgres` for the database.

# The application connects as a NON-OWNER role so row-level security is enforced.
DATABASE_URL=postgres://deuceleague_app:changeme@localhost:5432/deuceleague

# Migrations run as the role that owns the tables — the one docker compose creates.
MIGRATION_DATABASE_URL=postgres://deuceleague:changeme@localhost:5432/deuceleague

# Where `npm run api` listens; `npm run website` listens on WEBSITE_PORT (8080)
# and reaches the API at API_URL (http://localhost:3000).
PORT=3000
