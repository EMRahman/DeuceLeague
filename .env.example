# The application connects as a NON-OWNER role so row-level security is enforced.
# See docs/DATA-MODEL.md § Tenancy enforcement.
DATABASE_URL=postgres://deuceleague_app:changeme@localhost:5432/deuceleague

# Migrations run as the role that owns the tables — the one docker compose creates.
MIGRATION_DATABASE_URL=postgres://deuceleague:changeme@localhost:5432/deuceleague
